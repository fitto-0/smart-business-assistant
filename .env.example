# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_business_assistant
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# JWT Configuration (REQUIRED in production - generate a secure random string)
JWT_SECRET=your_jwt_secret_here_min_32_characters_long
JWT_EXPIRES_IN=24h

# Frontend Configuration
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_AI_URL=http://localhost:8000

# Backend Configuration
PORT=5000
NODE_ENV=development

# AI Service
AI_SERVICE_URL=http://localhost:8000

# Email Service (for invitations, password reset - optional for development)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@smartbusiness.com

# Stripe (for payments - optional for development)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Google OAuth (for Google Sheets integration - optional for development)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5000/api/integrations/google-sheets/callback

# Redis (for caching and sessions - optional for development)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Monitoring (Sentry - optional)
# SENTRY_DSN=your_sentry_dsn_here

GROQ_API_KEY=gsk_your_groq_api_key
